# Task 4 custom detection rules
alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP echo request (ping) detected"; itype:8; classtype:misc-activity; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible TCP SYN port scan"; flags:S; flow:stateless; detection_filter:track by_src, count 15, seconds 5; classtype:attempted-recon; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"LOCAL SSH connection attempt"; flags:S; flow:stateless; classtype:attempted-admin; sid:1000003; rev:1;)
